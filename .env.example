# ApplyPilot — LLM / runtime configuration
# Copy this file to ~/.applypilot/.env and add ONLY the keys you actually have.
# Keep this file out of Git.

# Recommended primary free/low-cost provider
GEMINI_API_KEY=
LLM_MODEL=gemini-2.5-flash
LLM_MODEL_QUALITY=gemini-2.5-flash

# OpenRouter — optional fallback.
# "openrouter/free" automatically selects an available free model.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_MODEL_QUALITY=openrouter/free

# Groq — optional fast fallback.
# These are current supported model IDs; account pricing/limits vary.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
GROQ_MODEL_QUALITY=openai/gpt-oss-120b

# DeepSeek — optional fallback
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# OpenAI — optional paid fallback
OPENAI_API_KEY=

# Anthropic — optional paid fallback for pipeline stages
ANTHROPIC_API_KEY=

# Local OpenAI-compatible endpoint — optional
# LLM_URL=http://127.0.0.1:11434/v1
# LLM_API_KEY=

# Browser / auto-apply
# Chrome is normally auto-detected.
# Set CHROME_PATH only if Chrome cannot be detected.
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# Proxy — optional
# PROXY=host:port:user:pass
